{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.8"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "herdr-van",
            "props": {
              "part": "brand"
            }
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "herdr-van",
                "props": {
                  "part": "spaces"
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "herdr-van",
                "props": {
                  "part": "agents"
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "herdr-van",
            "props": {
              "part": "footer"
            }
          },
          "size": {
            "px": 40
          }
        }
      ],
      "size": {
        "px": 268
      },
      "background": "#16161e00",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "herdr-van",
            "props": {
              "part": "tabs"
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "herdr-van",
                      "props": {
                        "part": "pane"
                      }
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "#1a1b2600",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 0,
                  "lone": true
                }
              }
            },
            {
              "id": "quota-panel",
              "type": "block",
              "content": {
                "mod": "quota"
              },
              "size": {
                "px": 320
              },
              "min": 240,
              "max": 560
            }
          ],
          "padding": 0
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/tokyo-grid.png",
    "fit": "cover"
  },
  "theme": "tokyo-night",
  "font": "JetBrainsMono Nerd Font Mono",
  "font_size": 13,
  "ui_font": "JetBrainsMono Nerd Font Mono",
  "terminal_padding": [
    5,
    2
  ],
  "terminal_opacity": 0,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
